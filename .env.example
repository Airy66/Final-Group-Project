# Precision Curator environment template
# Copy this file to .env for local development only. Never commit .env.

# -----------------------------------------------------------------------------
# Application and session settings
# Production: APP_ENV=production, a unique 32+ character secret, HTTPS base URL,
# and DEMO_MODE=false are required.
# -----------------------------------------------------------------------------
APP_ENV=development
FLASK_DEBUG=false
FLASK_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
SESSION_LIFETIME_HOURS=12
# Local development URL. Production must replace this with the public HTTPS
# Render service or custom domain, for example https://your-app.onrender.com.
APP_BASE_URL=http://127.0.0.1:5000
DEMO_MODE=false

# Local/demo controls. Keep all false in production.
DEMO_LOGIN_ENABLED=false
DEMO_TOOLS_ENABLED=false
DEMO_MEMBERSHIP_UPGRADE_ENABLED=false
DEVELOPER_ROLE_PREVIEW=false
MOCK_SEARCH_MODE=false
SHOW_DEMO_FALLBACK=false
SHOW_SEARCH_DIAGNOSTICS=false

# -----------------------------------------------------------------------------
# MongoDB persistence
# Use an authenticated MongoDB Atlas URI in staging/production.
# -----------------------------------------------------------------------------
MONGO_URI=mongodb+srv://precision_curator_app:<db_password>@your-cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DATABASE=precision_curator_production

# -----------------------------------------------------------------------------
# Password reset email
# EMAIL_MODE=console is local-only. Use EMAIL_MODE=smtp in staging/production.
# -----------------------------------------------------------------------------
EMAIL_MODE=console
REGISTRATION_WELCOME_EMAIL_ENABLED=true
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Precision Curator
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# Watchlist Monitor scheduled refresh
# Existing and newly created Monitors remain Off until a user enables one.
# -----------------------------------------------------------------------------
MONITOR_DAILY_REFRESH_ENABLED=false
MONITOR_AUTO_REFRESH_MAX_PER_USER=1
MONITOR_SCHEDULED_RUN_LIMIT=5
MONITOR_REFRESH_TIMEZONE=Asia/Singapore
MONITOR_DAILY_REFRESH_HOUR=8

# Watchlist price alerts evaluate saved snapshots and reuse the shared mail service.
PRICE_ALERTS_ENABLED=true
PRICE_ALERT_DEFAULT_THRESHOLD_PERCENT=5
PRICE_ALERT_COOLDOWN_HOURS=24

# -----------------------------------------------------------------------------
# eBay official Browse API
# -----------------------------------------------------------------------------
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# -----------------------------------------------------------------------------
# Walmart retrieval through the configured third-party SerpAPI service
# -----------------------------------------------------------------------------
SERPAPI_API_KEY=
SERPAPI_MARKETPLACE_ENABLED=true
SERPAPI_CACHE_TTL_HOURS=24
SERPAPI_DEMO_CACHE_TTL_HOURS=168
SERPAPI_LOCATION=
SERPAPI_COUNTRY=us
SERPAPI_CURRENCY=USD
SERPAPI_TIMEOUT_SECONDS=20
SERPAPI_EBAY_ENGINE=ebay
SERPAPI_WALMART_ENGINE=google_shopping

# Optional legacy browser fallback. Disabled by default and not recommended on
# Render. It does not represent official Walmart API access.
WALMART_BROWSER_FALLBACK=false
WALMART_BROWSER_HEADLESS=true
WALMART_BROWSER_TIMEOUT=25
WALMART_BROWSER_SETTLE_SECONDS=2.5
WALMART_LEGACY_SCRAPER=false

# -----------------------------------------------------------------------------
# AI assistance. AI output is explanatory and is not marketplace evidence.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
AI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=15000

# Optional search tuning
SEARCH_CONFIDENCE_THRESHOLD=0.55

# Administrator bootstrap values are supplied only in the invoking shell.
# Never place a real administrator password in this file.
PRECISION_ADMIN_EMAIL=administrator@example.com
PRECISION_ADMIN_DISPLAY_NAME=Administrator
PRECISION_ADMIN_PASSWORD=
